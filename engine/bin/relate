def _content_scope(var="n"):
    """Cypher fragment matching any content node.

    Single source for the content scope the deterministic tools share
    (embed-missing, verify, normalize-scan, categorize, clean-scan,
    communities, similar). CONTENT_LABELS is the list; a new ontology
    class joins the scope by one edit there. Decision / ReviewItem /
    Question / SpaceSignal are control-plane and stay out of scope.
    """
    return "(" + " OR ".join(f"{var}:{label}" for label in CONTENT_LABELS) + ")"
