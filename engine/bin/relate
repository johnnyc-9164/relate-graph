PROVISION_SCRIPT = os.path.join(HOME, "workspace/relate-space/graphs/provision-graph.sh")
ENSURE_API_SCRIPT = os.path.join(HOME, "workspace/relate-space/ensure-api.sh")
QUERY_PATH = "/db/neo4j/query/v2"
NEIGHBOR_LIMIT = 25

# --- Deterministic tool layer constants -------------------------------------
