OLLAMA_BASE = "http://127.0.0.1:11434"
EMBED_MODEL = "embeddinggemma-2"
EMBED_DIM = 768
# EmbeddingGemma 2 task formats (model card, "Task Instruction Prefixes"):
# corpus items are embedded in the document format (compose_embed_text);
# texts compared against each other (edge fact sentences) use the symmetric
# sentence-similarity format. The query-side prefix lives in relate-search.
EMBED_FORMAT = "eg2-doc-v1"
EMBED_FORMAT_EDGE = "eg2-sym-v1"
EMBED_SYM_PREFIX = "task: sentence similarity | query: "
_EMBED_STAMP = None


def resolved_model_stamp():
    """Resolved identity of EMBED_MODEL as Ollama serves it right now:
    '<parent_model>@<digest[:12]>' from /api/tags, so a re-pull or model
    swap can never hide behind the mutable tag name on stamped nodes.
    Falls back to the bare model name if the registry cannot be read."""
    global _EMBED_STAMP
    if _EMBED_STAMP:
        return _EMBED_STAMP
    stamp = EMBED_MODEL
    try:
        request = urllib.request.Request(OLLAMA_BASE + "/api/tags", method="GET")
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode())
        for entry in payload.get("models", []):
            name = entry.get("name") or ""
            if name == EMBED_MODEL or name.startswith(EMBED_MODEL + ":"):
                parent = (entry.get("details") or {}).get("parent_model") or name
                digest = (entry.get("digest") or "")[:12]
                stamp = f"{parent}@{digest}" if digest else parent
                break
    except Exception:
        pass
    _EMBED_STAMP = stamp
    return stamp

